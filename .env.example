# Public browser-to-API base URL. Leave empty when Vite proxies the API locally.
VITE_API_BASE_URL=

# Testnet-10 only. Mainnet is deliberately unsupported in v1.
VERITAS_KASPA_NETWORK=kaspa_testnet_10
# Set this to an operator-controlled Testnet-10 RPC endpoint; do not use a mainnet URL.
VERITAS_KASPA_RPC_URL=

# Local API state. Set VERITAS_DATA_KEY separately to a newly generated,
# base64-encoded 32-byte key; never commit a real key.
DATABASE_URL=sqlite://veritas.db

# Local UI testing only. When set to 1, the API accepts any non-empty wallet
# signature + public key without cryptographic verification. Never enable on a
# public deployment. Unset or any other value keeps auth fail-closed.
# VERITAS_ALLOW_INSECURE_AUTH=1
