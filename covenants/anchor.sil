pragma silverscript ^0.1.0;

// Veritas anchor: one covenant UTXO carrying the append-only accumulator of
// every batch root.
//
//   acc' = blake2b(acc || batch_root)
//
// The successor output must hold exactly that accumulator, the same batcher
// key and count + 1, so the chain refuses any update that is not an append:
// history cannot be rewritten, reordered or dropped, not even by the batcher.
// The batcher's signature (SIGHASH_ALL) covers the outputs, which binds the
// batch_root argument through the new state.
//
// Must stay in step with `veritas::accumulator::next_acc`.
contract VeritasAnchor(byte[32] init_batcher, byte[32] init_acc, int init_count) {
    byte[32] batcher = init_batcher;
    byte[32] acc = init_acc;
    int count = init_count;

    #[covenant.singleton(mode = transition, name = append)]
    function append_batch(State prev_state, byte[32] batch_root, sig batcher_sig) : (State) {
        require(checkSig(batcher_sig, pubkey(prev_state.batcher)));
        byte[32] next_acc = blake2b(byte[](prev_state.acc) + byte[](batch_root));
        return(State {
            batcher: prev_state.batcher,
            acc: next_acc,
            count: prev_state.count + 1
        });
    }
}
