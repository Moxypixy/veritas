// Cost-of-Living Pulse — monthly vote deposit covenant (local Argent).
//
// v1 trust boundary (approved Option A, 2026-08-10):
// - On-chain (this file): deposit lock amount, commitment hash storage,
//   per-lineage month monotonicity, reclaim/abandon thresholds, burn path.
// - Trusted indexer/API (later tasks): one ballot / one vote per wallet, and
//   that supplied YYYYMM matches the observed UTC calendar month. Consent UI
//   must state this split before voting.
//
// This Argent checkout exposes no UTC/DAA clock and no keyed wallet registry,
// so those two rules cannot be proven in-covenant today. `current_yyyymm` is
// caller input; unlock/abandon thresholds are stored on the deposit so a
// later caller cannot invent unrelated threshold months.
//
// Deposit: fixed 10_000_000 sompi (0.1 KAS).
// Unlock: next calendar month after the vote month.
// Reclaim window: unlock_yyyymm <= current < abandon_yyyymm.
// Abandon: current >= abandon_yyyymm (vote month + 3).

const int DEPOSIT_SOMPI = 10000000;

state BallotOfficeState {
    int ballots_opened;
}

state VoterBallotState {
    byte[32] voter;
    int last_month_yyyymm;
}

state VoteDepositState {
    byte[32] voter;
    int month_yyyymm;
    int unlock_yyyymm;
    int abandon_yyyymm;
    byte[32] commitment;
}

// Holds reclaimed deposit KAS until the voter closes it.
state WalletPurseState {
    byte[32] owner;
}

// `reject_spend` is deliberately unsatisfiable, so no Argent transition can
// spend this actor. `abandon` emits exactly this actor with the full deposit
// value; generated output validation binds the recipient to this fixed actor
// template/state.
state BurnState {
    int marker;
}

fn month_components_ok(yyyymm: int) -> int {
    int year = yyyymm / 100;
    int month = yyyymm - year * 100;
    int ok = 0;
    if (year >= 2026 && month >= 1 && month <= 12) {
        ok = 1;
    }
    return ok;
}

fn add_months(yyyymm: int, delta: int) -> int {
    int year = yyyymm / 100;
    int month = yyyymm - year * 100;
    int zero_based = year * 12 + (month - 1) + delta;
    int new_year = zero_based / 12;
    int new_month = zero_based - new_year * 12 + 1;
    return new_year * 100 + new_month;
}

actor BallotOffice owns BallotOfficeState {
    // Opens a per-wallet ballot tracker. One office can open many ballots.
    entry open_ballot(voter_sig: sig, voter_pk: pubkey) emits {
        office: BallotOffice;
        ballot: VoterBallot;
    } {
        require(checkSig(voter_sig, voter_pk));

        byte[32] voter = blake2b(voter_pk);
        BallotOfficeState next_office = {
            ballots_opened: ballots_opened + 1,
        };
        VoterBallotState new_ballot = {
            voter: voter,
            last_month_yyyymm: 0,
        };

        require(office.value == self.value);
        require(ballot.value > 0);

        become {
            office <- BallotOffice(next_office);
            ballot <- VoterBallot(new_ballot);
        };
    }
}

actor VoterBallot owns VoterBallotState {
    // Casts this month's vote: locks deposit + commitment, advances last_month.
    entry vote(
        voter_sig: sig,
        voter_pk: pubkey,
        month_yyyymm: int,
        current_yyyymm: int,
        commitment: byte[32]
    ) emits {
        ballot: VoterBallot;
        deposit: VoteDeposit;
    } {
        require(blake2b(voter_pk) == voter);
        require(checkSig(voter_sig, voter_pk));
        require(month_components_ok(month_yyyymm) == 1);
        require(month_components_ok(current_yyyymm) == 1);
        require(month_yyyymm == current_yyyymm);
        require(month_yyyymm > last_month_yyyymm);

        VoterBallotState next_ballot = {
            voter: voter,
            last_month_yyyymm: month_yyyymm,
        };
        VoteDepositState new_deposit = {
            voter: voter,
            month_yyyymm: month_yyyymm,
            unlock_yyyymm: add_months(month_yyyymm, 1),
            abandon_yyyymm: add_months(month_yyyymm, 3),
            commitment: commitment,
        };

        require(ballot.value == self.value);
        require(deposit.value == DEPOSIT_SOMPI);

        become {
            ballot <- VoterBallot(next_ballot);
            deposit <- VoteDeposit(new_deposit);
        };
    }
}

actor VoteDeposit owns VoteDepositState {
    // Reclaim during unlock..grace. UTC correctness is an indexer/API duty.
    entry reclaim(
        voter_sig: sig,
        voter_pk: pubkey,
        current_yyyymm: int
    ) emits {
        purse: WalletPurse;
    } {
        require(blake2b(voter_pk) == voter);
        require(checkSig(voter_sig, voter_pk));
        require(month_components_ok(current_yyyymm) == 1);
        require(unlock_yyyymm == add_months(month_yyyymm, 1));
        require(abandon_yyyymm == add_months(month_yyyymm, 3));
        require(current_yyyymm >= unlock_yyyymm);
        require(current_yyyymm < abandon_yyyymm);
        require(purse.value == self.value);

        WalletPurseState next_purse = {
            owner: voter,
        };

        become purse <- WalletPurse(next_purse);
    }

    // After the recorded grace threshold, anyone may burn the full deposit to
    // the fixed Burn actor. This is deliberately not `emits none`.
    entry abandon(current_yyyymm: int) emits {
        burn: Burn;
    } {
        require(month_components_ok(current_yyyymm) == 1);
        require(unlock_yyyymm == add_months(month_yyyymm, 1));
        require(abandon_yyyymm == add_months(month_yyyymm, 3));
        require(current_yyyymm >= abandon_yyyymm);
        require(burn.value == self.value);

        BurnState burned = {
            marker: 1,
        };

        become burn <- Burn(burned);
    }
}

actor Burn owns BurnState {
    entry reject_spend() emits none {
        require(0 == 1);
    }
}

actor WalletPurse owns WalletPurseState {
    entry close(owner_sig: sig, owner_pk: pubkey) emits none {
        require(blake2b(owner_pk) == owner);
        require(checkSig(owner_sig, owner_pk));
    }
}

app Pulse {
    actor BallotOffice;
    actor VoterBallot;
    actor VoteDeposit;
    actor Burn;
    actor WalletPurse;
}
